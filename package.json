{
  "name": "demo-playwright-cli",
  "version": "1.0.0",
  "description": "Playwright TypeScript base project using SauceDemo as sample web app",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:auth": "playwright test tests/auth/",
    "test:inventory": "playwright test tests/inventory/",
    "test:cart": "playwright test tests/cart/",
    "pw:install": "playwright install",
    "pw:codegen:saucedemo": "playwright codegen https://www.saucedemo.com",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:env": "tsx scripts/env-check.ts",
    "archive": "tsx scripts/archive-results.ts",
    "compare": "tsx scripts/compare-runs.ts",
    "gate": "tsx scripts/release-gate.ts",
    "flaky": "tsx scripts/flaky-detect.ts",
    "coverage:gaps": "tsx scripts/coverage-gaps.ts",
    "notify": "tsx scripts/notify.ts",
    "pipeline": "tsx scripts/full-pipeline.ts",
    "test:archive": "playwright test && npm run archive",
    "hermes:orchestrator": "tsx scripts/agents/hermes-orchestrator.ts",
    "hermes:once": "tsx scripts/agents/hermes-orchestrator.ts --once",
    "hermes:ingest": "tsx scripts/agents/story-ingestion-agent.ts",
    "hermes:codebase": "tsx scripts/agents/codebase-intelligence-agent.ts",
    "hermes:generate": "tsx scripts/agents/test-case-generation-agent.ts",
    "hermes:gate": "tsx scripts/agents/coverage-gate-agent.ts",
    "hermes:learn": "tsx scripts/agents/self-learning-agent.ts",
    "hermes:automate": "tsx scripts/agents/test-automation-agent.ts",
    "hermes:heal": "tsx scripts/agents/self-healing-agent.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jptaba/demo-playwright-cli.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jptaba/demo-playwright-cli/issues"
  },
  "homepage": "https://github.com/jptaba/demo-playwright-cli#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.13",
    "@playwright/mcp": "^0.0.75",
    "@playwright/test": "^1.60.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-plugin-playwright": "^2.10.4",
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.1.1",
    "node-cron": "^4.2.1",
    "openai": "^6.39.1",
    "playwright": "^1.60.0",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.60.0",
    "zod": "^4.4.3"
  }
}
