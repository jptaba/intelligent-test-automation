# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit it.

# ── SauceDemo (required for Playwright tests) ──────────────────────────────
STANDARD_USER=standard_user
USER_PASSWORD=secret_sauce
BASE_URL=https://www.saucedemo.com
LOCKED_USER=locked_out_user
PROBLEM_USER=problem_user

# ── Jira (required for hermes:ingest) ────────────────────────────────────────
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ
JIRA_TESTING_STATUS_FIELD=customfield_10234
JIRA_ASSIGNEE_FILTER=your-email@example.com

# ── Confluence (optional — for enriched story context) ────────────────────────
CONFLUENCE_BASE_URL=https://yourorg.atlassian.net/wiki

# ── Figma (optional — for screenshot descriptions) ────────────────────────────
FIGMA_API_TOKEN=

# ── LLM (required for hermes:generate, hermes:codebase, hermes:gate, etc.) ────
# Supported providers: openai | anthropic | azure
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://yourorg.openai.azure.com  # Only for Azure OpenAI

# ── Hermes Orchestrator ────────────────────────────────────────────────────────
HERMES_ASSIGNEE_FILTER=your-email@example.com
HERMES_SCHEDULE=0 * * * *
HERMES_MAX_RETRIES=3

# ── Notifications (optional) ──────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
